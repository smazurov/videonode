{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "testenv hook post-tool-use",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "testenv hook pre-tool-use",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "testenv release-session \"${CLAUDE_SESSION_ID:-}\" \u003e/dev/null 2\u003e\u00261 || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "testenv hook session-end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "testenv reap \u003e/dev/null 2\u003e\u00261 || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "testenv hook session-start",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "testenv hook worktree-remove",
            "type": "command"
          }
        ]
      }
    ]
  }
}
