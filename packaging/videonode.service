[Unit]
Description=VideoNode streaming server
After=network.target

[Service]
Type=simple
User=videonode
Group=video
WorkingDirectory=/etc/videonode
ExecStartPre=-/usr/bin/videonode validate-encoders --quiet
# Enable Rockchip MPP load sampling so the daemon (non-root) can read
# /proc/mpp_service/load. The '+' runs this line as root; the load_interval
# node is root-owned 0644 and has no module-param/cmdline alternative. Guarded
# by 'test -w' so it is a clean no-op on hosts without the MPP service.
ExecStartPre=+/bin/sh -c 'test -w /proc/mpp_service/load_interval && echo 1000 > /proc/mpp_service/load_interval || true'
ExecStart=/usr/bin/videonode -c /etc/videonode/config.toml
Restart=on-failure
RestartSec=5
# slog's JournalHandler already writes structured entries to journald; discard
# stdout so systemd doesn't capture a second plain-text copy of every line.
StandardOutput=null
StandardError=journal
# No shadow group: password verification is privilege-separated into the
# setuid-root videonode-session helper, so neither the daemon nor any child
# it spawns (ffmpeg, videonode-*) can read /etc/shadow. Do not add
# NoNewPrivileges=true (or hardening that implies it) — it would block the
# helper's setuid transition and silently break Linux auth.
SupplementaryGroups=video render audio
Environment=ALSA_CONFIG_PATH=/usr/share/videonode/videonode.asound.conf

[Install]
WantedBy=multi-user.target
