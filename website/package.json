{
  "name": "videonode-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changelog": "chglog format --template-file scripts/changelog.tpl -i ../changelog.yml -o docs/changelog.md",
    "predev": "pnpm changelog",
    "prebuild": "pnpm changelog",
    "dev": "vitepress dev docs --port 5174",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "start": "vitepress dev docs --host 0.0.0.0 --port 5174"
  },
  "devDependencies": {
    "mermaid": "^11.15.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
